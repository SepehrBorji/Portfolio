---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title}>
  <article class="project-detail">
    <h1 class="text-center">{project.data.title}</h1>
      <div class="project-media center">
        <img src={project.data.image} alt={project.data.title} />
      </div>
    <div class="project-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-detail {
    max-width: 1000px;
    margin: var(--space-8) auto;
    padding: var(--space-6);
    background-color: var(--color-surface-inverted);
    color: var(--color-text-inverted);
    border: 2px groove var(--color-text-inverted);
    border-radius: 10px;
  }
 
  .project-media {
    margin: var(--space-6) 0;
  }
 
  .project-media img {
    max-width: 100%;
    max-height: 450px;
    border-radius: 8px;
  }
 
  .project-body {
    font-size: var(--text-base);
    line-height: 1.6;
  }
 
  /* :global() is required here — this content comes from <Content />,
     rendered markdown, not from this component's own template. */
  .project-body :global(p) {
    margin: 0 0 var(--space-4);
  }

  .project-body :global(h1,h2,h3,h4,h5,h6) {
    margin: 0 0 var(--space-1);
  }

  .project-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: var(--space-4) auto;
    border-radius: 8px;
  }

  .project-body :global(img.img-small) {
    max-width: 40%;
  }
 
  .project-body :global(img.img-medium) {
    max-width: 70%;
  }
 
  .project-body :global(img.img-large) {
    max-width: 100%;
  }


 
  .project-body :global(ul) {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
 
  .project-body :global(a) {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-accent);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    border-radius: 8px;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
 
  @media (hover: hover) and (pointer: fine) {
    .project-body :global(a:hover) {
      background-color: var(--color-accent-hover);
      transform: scale(1.15);
    }
  }
 
  .project-body :global(a:active) {
    background-color: var(--color-accent-hover);
    transform: scale(0.95);
  }

  /* main already adds a var(--space-4) gutter, so this panel's own
     padding shrinks under the mobile breakpoint instead of stacking
     insets on top of it. */
  @media (max-width: 640px) {
    .project-detail {
      padding: var(--space-4);
      margin-block: var(--space-6);
    }
  }
</style>