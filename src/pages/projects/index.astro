---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfilePic from '../../components/ProfilePic.astro';

const projects = await getCollection('projects');
const sorted = projects.sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Projects">
  <ProfilePic />
  <h1 class="text-center">Projects</h1>
  <ul class="project-grid flex">
    {sorted.map(project => (
      <li>
        <a class="project-card" href={`/projects/${project.id}`}>
          <img src={project.data.image} alt={project.data.title} />
          <h2>{project.data.title}</h2>
          <p>{project.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .project-grid {
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
  }
 
  .project-card {
    display: block;
    width: 300px;
    padding: var(--space-3);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-align: center;
    text-decoration: none;
    color: var(--color-text);
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
 
  .project-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 8px;
  }
 
  .project-card h2 {
    font-size: var(--text-lg);
    margin: var(--space-3) 0 var(--space-1);
  }
 
  .project-card p {
    font-size: var(--text-sm);
    margin: 0;
  }
 
  .project-card:hover {
    background-color: var(--color-surface-inverted);
    color: var(--color-text-inverted);
    transform: scale(1.15);
  }
 
  .project-card:active {
    transform: scale(0.95);
  }
</style>
