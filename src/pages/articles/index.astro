---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfilePic from '../../components/ProfilePic.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const articles = await getCollection('articles');
const sorted = articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Articles">
  <div class="fade-in-up">
    <ProfilePic />
  </div>
  <div class="fade-in-up">
    <h1 class="text-center">Articles</h1>
    <ul class="article-grid flex">
      {sorted.map((article) => <ArticleCard article={article} />)}
    </ul>
  </div>
</BaseLayout>

<style>
  .article-grid {
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
  }

  .article-card li {
    width: min(300px, 100%);
  }
 
  .article-card {
    display: block;
    width: 100%;
    padding: var(--space-3);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-align: center;
    text-decoration: none;
    color: var(--color-text);
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
 
  .article-card img {
    width: 100%;
    height: 200px;
    object-fit: contain;
    border-radius: 8px;
  }
 
  .article-card h2 {
    font-size: var(--text-lg);
    margin: var(--space-3) 0 var(--space-1);
  }
 
  .article-card p {
    font-size: var(--text-sm);
    margin: 0;
  }
 
  @media (hover: hover) and (pointer: fine) {
    .article-card:hover {
      background-color: var(--color-surface-inverted);
      color: var(--color-text-inverted);
      transform: scale(1.15);
    }
  }
 
  .article-card:active {
    background-color: var(--color-surface-inverted);
    color: var(--color-text-inverted);
    transform: scale(0.95);
  }
</style>