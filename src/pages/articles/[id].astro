---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout title={article.data.title}>
  <article class="article-detail">
    <h1 class="text-center">{article.data.title}</h1>
      <div class="article-media center">
        <img src={article.data.image} alt={article.data.title} />
      </div>
    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article-detail {
    max-width: 700px;
    margin: var(--space-8) auto;
    padding: var(--space-6);
    background-color: var(--color-surface-inverted);
    color: var(--color-text-inverted);
    border: 2px groove var(--color-text-inverted);
    border-radius: 10px;
  }

  .article-media {
    margin: var(--space-6) 0;
  }

  .article-media img {
    max-width: 100%;
    max-height: 450px;
    border-radius: 8px;
  }

  .article-body {
    font-size: var(--text-base);
    line-height: 1.6;
  }

  /* :global() is required here — this content comes from <Content />,
     rendered markdown, not from this component's own template. */

  .article-body :global(p) {
    margin: 0 0 var(--space-4);
  }

  .article-body :global(h2) {
    font-size: var(--text-xl);
    margin: var(--space-6) 0 var(--space-3);
  }

  .article-body :global(h3) {
    font-size: var(--text-lg);
    margin: var(--space-5) 0 var(--space-2);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-6);
  }

  .article-body :global(li) {
    margin-bottom: var(--space-2);
  }

  .article-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .article-body :global(a:hover) {
    color: var(--color-accent-hover);
  }

  .article-body :global(blockquote) {
    margin: var(--space-4) 0;
    padding-left: var(--space-4);
    border-left: 4px solid var(--color-accent);
    font-style: italic;
  }

  .article-body :global(code) {
    background-color: rgba(0, 0, 0, 0.08);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .article-body :global(pre) {
    background-color: var(--color-bg-elevated);
    color: var(--color-text);
    padding: var(--space-4);
    border-radius: 8px;
    overflow-x: auto;
    margin: 0 0 var(--space-4);
  }

  .article-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .article-body :global(img) {
    max-width: 100%;
    border-radius: 8px;
    margin: var(--space-4) 0;
  }
</style>
